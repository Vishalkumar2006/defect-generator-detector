{
  "experiment_version": "g2_3b_mature_budget_prevalence_controlled_utility_v1",
  "stage": "precommitted_protocol",
  "hypothesis": "Frozen GAN checkpoint 1,500 provides detector utility beyond the effect of increasing defective-sample prevalence, when detectors are trained to a mature budget under a common training protocol.",
  "immutable_inputs": {
    "g2_2_config_path": "configs/g2_2_detector_utility.json",
    "g2_2_terminal_decision": "stop_not_confirmed",
    "g2_3a_summary_path": "reports/g2_3/diagnostic/diagnostic_summary.json",
    "historical_baseline_config_path": "configs/final_real_baseline_bf16.json",
    "historical_baseline_report_directory": "reports/final_real_baseline_bf16_seed42",
    "historical_baseline_updates_per_epoch": 496,
    "historical_baseline_epochs": 12,
    "historical_baseline_total_updates": 5952,
    "bbox_statistics_path": "reports/preprocessing/bbox_statistics.csv"
  },
  "access_policy": {
    "official_test_allowed": false,
    "official_test_allowed_after_confirmation": false,
    "evaluation_splits_allowed": ["validation"],
    "training_splits_allowed": ["train"],
    "gan_updates_allowed": false,
    "regenerate_synthetic_allowed": false,
    "reuses_frozen_g2_2_synthetic": true,
    "modifies_g2_2_artifacts": false,
    "modifies_g2_3a_artifacts": false,
    "forbidden_gan_checkpoints": ["checkpoint_1000", "checkpoint_2000"]
  },
  "seeds": [45, 46, 47],
  "arms": {
    "standard_real": {
      "label": "A",
      "role": "secondary_reference",
      "normal_real_fraction": 0.5,
      "defective_real_fraction": 0.5,
      "synthetic_fraction": 0.0,
      "batch_pattern": [
        ["normal_real", "defective_real", "normal_real", "defective_real"],
        ["normal_real", "defective_real", "normal_real", "defective_real"]
      ]
    },
    "prevalence_matched_real": {
      "label": "B",
      "role": "primary_control",
      "normal_real_fraction": 0.375,
      "defective_real_fraction": 0.625,
      "synthetic_fraction": 0.0,
      "batch_pattern": [
        ["normal_real", "defective_real", "normal_real", "defective_real"],
        ["normal_real", "defective_real", "defective_real", "defective_real"]
      ]
    },
    "gan_1500": {
      "label": "C",
      "role": "primary_candidate",
      "normal_real_fraction": 0.375,
      "defective_real_fraction": 0.375,
      "synthetic_fraction": 0.25,
      "batch_pattern": [
        ["normal_real", "defective_real", "normal_real", "synthetic"],
        ["normal_real", "defective_real", "defective_real", "synthetic"]
      ]
    }
  },
  "comparisons": {
    "primary": {
      "candidate": "gan_1500",
      "control": "prevalence_matched_real",
      "gated": true,
      "question": "utility of frozen checkpoint-1500 synthetic content at matched effective defect prevalence"
    },
    "secondary": {
      "candidate": "standard_real",
      "control": "prevalence_matched_real",
      "gated": false,
      "question": "effect of raising effective defect prevalence from 0.500 to 0.625 with real defective samples only"
    }
  },
  "training": {
    "protocol": "mature_stabilized_bf16_semantics",
    "optimizer_updates_per_epoch": 496,
    "batch_size": 4,
    "sample_slots_per_epoch": 1984,
    "maximum_epochs": 12,
    "total_optimizer_updates": 5952,
    "skipped_updates_allowed": 0,
    "maximum_optimizer_updates_per_attempt": 1,
    "num_workers": 0,
    "pin_memory": true,
    "model": {
      "architecture": "groupnorm_unet",
      "input_channels": 3,
      "output_channels": 1,
      "base_channels": 32
    },
    "optimizer": {
      "type": "AdamW",
      "learning_rate": 0.0003,
      "weight_decay": 0.0001
    },
    "scheduler": {
      "type": "ReduceLROnPlateau",
      "monitor": "validation_total_loss",
      "mode": "min",
      "factor": 0.5,
      "patience": 2,
      "minimum_learning_rate": 0.00001
    },
    "early_stopping": {
      "enforced": false,
      "monitor_only": true,
      "monitor": "validation_total_loss",
      "mode": "min",
      "patience": 4,
      "minimum_delta": 0.0,
      "reason": "Equal optimizer-update budgets across arms are a hard G2.3B requirement; the historical baseline configured early stopping but never triggered it, so it is recorded as monitor-only evidence instead of acted upon."
    },
    "loss": {
      "type": "valid_region_bce_with_logits_plus_soft_dice",
      "bce_weight": 1.0,
      "dice_weight": 1.0,
      "pos_weight": 5.0,
      "compute_dtype": "float32"
    },
    "precision": {
      "mode": "bf16",
      "grad_scaler": false,
      "automatic_fp32_retry": false,
      "gradient_clip_max_norm": 1.0
    },
    "augmentation": {
      "training_only": true,
      "horizontal_flip_probability": 0.5,
      "vertical_flip_probability": 0.5,
      "synchronized_fields": ["image", "mask", "valid_region"],
      "mask_interpolation": "none",
      "additional_transforms": [],
      "keying": "seed_epoch_sample_id"
    },
    "checkpoint_selection": {
      "monitor": "validation_total_loss",
      "mode": "min",
      "scope": "best_epoch_over_all_12_epochs",
      "identical_rule_across_arms": true
    },
    "sampling": {
      "framework": "one_common_scheduling_framework_for_all_arms",
      "within_class_law": "uniform_with_replacement",
      "stream_key": "experiment_version:seed:epoch:class_stream",
      "arm_independent_streams": true,
      "arms_consume_prefixes_of_the_same_class_streams": true,
      "note": "Per (seed, epoch, class) one deterministic draw stream is built to the longest length any arm needs. Every arm consumes a prefix of that identical stream, so the k-th normal-real draw and the k-th defective-real draw of an epoch are the same identity in every arm."
    }
  },
  "data": {
    "manifest": "data/metadata/ksdd2_split_seed42.csv",
    "training_split": "train",
    "validation_split": "validation",
    "official_test_evaluation": false,
    "canvas_width": 256,
    "canvas_height": 672,
    "resize_or_distort": false,
    "image_padding_mode": "reflect",
    "mask_padding_mode": "zero",
    "loss_and_metrics_region": "valid_original_pixels_only",
    "detector_normalization": {
      "input_range": [0.0, 1.0],
      "mean": [0.17536929644393365, 0.1709092379799471, 0.17704063222181007],
      "standard_deviation": [0.04440419892392204, 0.03818317039850739, 0.03754433462546375],
      "source": "development_train original pixels only"
    }
  },
  "synthetic": {
    "source": "frozen_g2_2_materialized_checkpoint_1500",
    "variant": "checkpoint_1500",
    "manifest_path": "reports/g2_2/synthetic_manifests/checkpoint_1500.json",
    "pairing_report_path": "reports/g2_2/synthetic_manifests/pairing_report.json",
    "expected_sample_count": 512,
    "regenerate": false,
    "frozen_gan_checkpoint_path": "checkpoints/gan_training_2000/joint_1500.pt",
    "frozen_gan_checkpoint_sha256": "5af1c6aafabcc0444117aa43209dcab168e57f4489259728e8f9066a4fdf1c81",
    "frozen_gan_checkpoint_step": 1500,
    "frozen_manifest_content_sha256": "9eba21b4347dcdafafd9d0f90dd06b297cb58b2f7ee58f1887fed7a4cd62ca91",
    "frozen_pairing_report_content_sha256": "540a4637936c25ae9fd3678732bbc9d81e75f066e584e6d3ee078768f491ed33",
    "verify_row_file_hashes": true,
    "require_every_sample_defective": true
  },
  "threshold_selection": {
    "policy": "precommitted_identical_rule_for_every_arm_and_seed",
    "data_source": "validation",
    "executed": "once_per_arm_after_training_completes_and_best_checkpoint_reloads",
    "grid": {
      "minimum": 0.01,
      "maximum": 0.99,
      "increment": 0.01,
      "construction": "integer_hundredths_range_inclusive",
      "point_count": 99
    },
    "objective": "maximum_validation_global_dice",
    "tie_breaking": [
      "maximum global_dice",
      "then maximum mean_defective_image_dice",
      "then maximum pixel_precision",
      "then smallest threshold"
    ],
    "secondary_fixed_threshold": 0.5,
    "secondary_fixed_threshold_role": "continuity_evidence_only_never_a_gate_input",
    "threshold_independent_metric": "pixel_pr_auc",
    "pr_auc_grid": {
      "probability_step": 0.0005,
      "logit_limit": 20.0,
      "logit_step": 0.02,
      "estimator": "step_rule_average_precision"
    }
  },
  "reported_metrics_at_selected_threshold": [
    "global_dice",
    "global_iou",
    "pixel_precision",
    "pixel_recall",
    "normal_image_false_positive_rate",
    "image_recall",
    "stratified_border_dice_and_recall",
    "stratified_non_border_dice_and_recall",
    "stratified_small_dice_and_recall",
    "stratified_medium_dice_and_recall",
    "stratified_large_dice_and_recall"
  ],
  "confirmation_gate": {
    "frozen_before_training": true,
    "primary_candidate": "gan_1500",
    "primary_control": "prevalence_matched_real",
    "seeds": [45, 46, 47],
    "required_seed_count": 3,
    "evaluated_at": "precommitted_selected_operating_threshold",
    "minimum_mean_global_dice_gain": 0.01,
    "minimum_mean_global_iou_gain": 0.005,
    "maximum_mean_normal_fpr_regression": 0.02,
    "maximum_mean_precision_regression": 0.01,
    "maximum_mean_recall_regression": 0.01,
    "minimum_positive_dice_seeds": 2,
    "minimum_mean_pixel_pr_auc_gain": 0.01,
    "minimum_positive_pr_auc_seeds": 2,
    "justification": {
      "dice_iou_fpr_precision_recall": "Carried over unchanged from the frozen G2.2 selection rules in configs/g2_2_detector_utility.json so the multimetric safeguard is not weakened.",
      "positive_dice_seeds": "Carried over unchanged from the G2.2 three-seed confirmation rule.",
      "pixel_pr_auc": "Added, not substituted. G2.3A showed threshold-0.5 comparisons are calibration-sensitive, so a threshold-independent criterion is required in addition to every G2.2 criterion. The 0.01 magnitude mirrors the G2.2 minimum Dice gain because both are bounded [0,1] aggregate quality measures; G2.3A observed per-seed PR-AUC deltas of +0.104/-0.029/+0.050 at the immature budget, so 0.01 is well inside the measurable range.",
      "no_value_was_chosen_from_any_g2_3b_result": true
    }
  },
  "paths": {
    "report_directory": "reports/g2_3b",
    "checkpoint_directory": "checkpoints/g2_3b",
    "plan_directory": "reports/g2_3b/plan"
  }
}
