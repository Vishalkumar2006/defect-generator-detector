{
  "smoke_version": "g1_5a_gated_gan_smoke_v1",
  "trainer_config_path": "configs/gan_one_step.json",
  "training_pair_config_path": "configs/gan_training_pairs.json",
  "architecture_config_path": "configs/gan_architecture.json",
  "loss_config_path": "configs/gan_losses.json",
  "detector_config_path": "configs/final_real_baseline_bf16.json",
  "detector_checkpoint_path": "checkpoints/final_real_baseline_bf16_seed42/best.pt",
  "report_directory": "reports/gan_training/smoke",
  "checkpoint_directory": "checkpoints/gan_smoke",
  "seed": 42,
  "device": "cuda",
  "precision": "bf16",
  "batch_size": 2,
  "num_workers": 2,
  "prefetch_factor": 2,
  "pin_memory": true,
  "persistent_workers": false,
  "batches_per_data_epoch": 100,
  "generator_learning_rate": 0.0001,
  "discriminator_learning_rate": 0.00005,
  "adam_betas": [0.0, 0.9],
  "weight_decay": 0.0,
  "discriminator_steps_per_generator_step": 1,
  "generator_gradient_clip_max_norm": 5.0,
  "discriminator_gradient_clip_max_norm": 5.0,
  "generator_loss_weights": {
    "adversarial": 1.0,
    "change": 1.0,
    "boundary": 1.0,
    "total_variation": 0.1
  },
  "r1_gamma": 1.0,
  "r1_interval": 16,
  "initial_discriminator_warmup_steps": 10,
  "maximum_discriminator_warmup_steps": 20,
  "micro_smoke_joint_steps": 20,
  "full_smoke_joint_steps": 200,
  "monitor_interval": 20,
  "visual_interval": 25,
  "checkpoint_interval": 25,
  "progress_interval": 10,
  "visual_steps": [0, 20, 50, 100, 150, 200],
  "monitor_panel_scan_limit": 1000,
  "detector_threshold": 0.5,
  "detector_inside_retention_warning_ratio": 0.7,
  "detector_inside_retention_stop_ratio": 0.5,
  "detector_dice_warning_drop": 0.15,
  "absolute_logit_stop": 20.0,
  "output_range_violation_stop_count": 0,
  "mean_support_change_stop": 0.25,
  "provisional_configuration": true
}
