.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

.idea/
.vscode/
*.suo
*.user

data/raw/*.zip
data/extracted/*
!data/extracted/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/metadata/*
!data/metadata/.gitkeep
!data/metadata/ksdd2_split_seed42.csv

checkpoints/
models/checkpoints/
*.ckpt
*.pth
*.pt
data/synthetic/
synthetic_data/

# Numerical probes keep compact summaries/anomalies; per-batch dumps are local diagnostics.
reports/numerical_stability/*/batch_telemetry.csv

# Raw precision diagnostics contain local absolute checkpoint paths; sanitized findings are tracked.
reports/final_real_baseline/precision_diagnostic/

# G2.2 materialized rows and expanded schedules are reproducible local artifacts;
# compact pairing, arm, pilot, and confirmation audits remain tracked.
reports/g2_2/synthetic_manifests/checkpoint_*.json
reports/g2_2/**/*_schedule.json
reports/g2_2/**/*_progress.json

# G2.3A per-threshold curves and per-mask records are bulk reproducible local
# diagnostics; the compact G2.3A audits and diagnostic summary remain tracked.
reports/g2_3/diagnostic/threshold_curves/
reports/g2_3/diagnostic/synthetic_mask_records.json

# G2.3B expanded per-slot schedules and detector checkpoints are reproducible
# local artifacts; the compact precommitted plan, arm reports, and confirmation
# summary remain tracked.
reports/g2_3b/plan/seed*/
reports/g2_3b/**/*_schedule.json
reports/g2_3b/**/*_epochs.json

# ---------------------------------------------------------------------------
# Public-release policy (v1.0.0)
# ---------------------------------------------------------------------------
# KSDD2 is third-party data under CC BY-NC-SA 4.0 and is NOT redistributed by
# this repository. Nothing that contains KSDD2 pixels may be tracked. Obtain the
# dataset yourself (docs/dataset-setup.md) and regenerate these artifacts locally.

# Raw / extracted / processed KSDD2 (belt-and-braces over the rules above).
data/raw/**
!data/raw/.gitkeep
data/**/*.png
data/**/*.jpg
data/**/*.jpeg
data/**/*.bmp
data/**/*.tif
data/**/*.tiff

# Report figures that embed KSDD2 image or mask pixels. Regenerate locally with
# the visualization/audit scripts listed in docs/README.md.
reports/**/contact_sheet.png
reports/**/contact_sheets/
reports/**/blinded_sheets/
reports/**/*_contact_sheet.png
reports/**/*overlay*.png
reports/**/*overlays*.png
reports/**/fixed_validation_diagnostics.png
reports/**/*patch_examples.png
reports/**/*patch_comparison.png
reports/demo/

# Untracked local audit artifacts predating the release; keep on disk, never stage.
reports/g2_2.zip
reports/gan_inputs/manifest.json
reports/gan_inputs/sampling_audit_f1_4.json
reports/gan_inputs/sampling_audit_f1_4.md
reports/gan_inputs/summary.json
reports/gan_inputs/summary.md
reports/gan_inputs/visualizations/
